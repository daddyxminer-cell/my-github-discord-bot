# Copy this file to .env and fill it in

# Discord channel webhook (Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# GitHub token (https://github.com/settings/tokens -> "Generate new token (classic)", NO scopes needed).
# Without it GitHub only allows 60 requests/hour and searches get cut short.
GITHUB_TOKEN=

# Name shown in Discord (empty = the webhook's own name, e.g. "Captain Hook")
BOT_NAME=

# How often to check, in minutes (only used when running without --once)
CHECK_INTERVAL_MINUTES=30

# Only look at repos created in the last N hours
MAX_AGE_HOURS=48

# How sure the bot must be. Higher = fewer but more certain posts (try 9-10 if you get noise)
MIN_SCORE=7

# true = also post node / masternode projects. false = PoW coins only
INCLUDE_NODE=true

# After posting a repo, skip other repos of the same owner (wallet, pool, explorer...) for N days. 0 = off
ONE_PER_OWNER_DAYS=30

# Ignore repos with fewer stars than this
MIN_STARS=0

# true = add a small second line: type, algorithm, language
SHOW_DETAILS=false

# true = on the very first start, also post what was found. false = post nothing until a brand-new repo appears
POST_ON_FIRST_RUN=false
